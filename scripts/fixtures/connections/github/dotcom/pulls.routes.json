{
  "prefix": "/api/v3/repos/octo-org/widgets",
  "routes": [
    {
      "path": "/pulls",
      "query": { "head": "octo-org:aico/task-42", "state": "open" },
      "responses": [
        { "status": 200, "body": [] },
        {
          "status": 200,
          "body": [ { "number": 7, "state": "open", "head": { "ref": "aico/task-42", "sha": "a1b2c3d4e5f60718293a4b5c6d7e8f9012345678" } } ]
        }
      ]
    },
    {
      "path": "/pulls",
