{
  "name": "acme_pr_find",
  "description": "Open pull requests from a branch.",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "owner": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]{1,100}$"
      },
      "name": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]{1,100}$"
      },
      "head": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._/-]{1,200}$"
      }
    },
    "required": [
      "owner",
      "name",
      "head"
    ]
  },
  "http": {
    "method": "GET",
    "url": "https://api.acme-forge.example/v1/repos/{owner}/{name}/pulls?head={head}&state=open"
  },
  "effect": "read"
}
