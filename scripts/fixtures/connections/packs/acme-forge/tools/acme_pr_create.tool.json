{
  "name": "acme_pr_create",
  "description": "Open a pull request.",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "owner": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]{1,100}$"
      },
      "name": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]{1,100}$"
      },
      "head": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._/-]{1,200}$"
      },
      "base": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._/-]{1,200}$"
      },
      "title": {
        "type": "string",
        "maxLength": 300
      },
      "body": {
        "type": "string",
        "maxLength": 70000
      },
      "draft": {
        "type": "boolean"
      }
    },
    "required": [
      "owner",
      "name",
      "head",
      "base",
      "title"
    ]
  },
  "http": {
    "method": "POST",
    "url": "https://api.acme-forge.example/v1/repos/{owner}/{name}/pulls",
    "body": {
      "title": "{title}",
      "head": "{head}",
      "base": "{base}",
      "body": "{body}",
      "draft": "{draft}"
    }
  },
  "effect": "external"
}
