{
  "name": "aico-vscode",
  "displayName": "aico \u2014 AI coding agent",
  "description": "A native aico panel in VS Code: its own view beside Chat, with the session list, tool cards and diffs drawn in your editor theme. Ask about a selection, watch background work in the status bar, and open the full workspace when you want the width.",
  "version": "0.5.1",
  "publisher": "suhail-akhtar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/suhail-akhtar/aico.git",
    "directory": "vscode-extension"
  },
  "homepage": "https://suhail-akhtar.github.io/aico/",
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "coding agent",
    "agent",
    "llm",
    "claude",
    "ollama",
    "mcp"
  ],
  "engines": {
    "vscode": "^1.94.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "aico runs an agent that reads and writes files in this folder and can execute shell commands, so it stays off until you trust the workspace. Declared explicitly so Restricted Mode says the panel is disabled and offers a Trust button \u2014 rather than the panel silently not appearing."
    }
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "aicoSecondary",
          "title": "aico",
          "icon": "resources/aico.svg",
          "when": "!aico:noSecondarySidebar"
        }
      ],
      "activitybar": [
        {
          "id": "aicoPrimary",
          "title": "aico",
          "icon": "resources/aico.svg",
          "when": "aico:noSecondarySidebar"
        }
      ]
    },
    "views": {
      "aicoSecondary": [
        {
          "id": "aico.chatSecondary",
          "type": "webview",
          "name": "aico",
          "when": "!aico:noSecondarySidebar"
        }
      ],
      "aicoPrimary": [
        {
          "id": "aico.chat",
          "type": "webview",
          "name": "aico",
          "when": "aico:noSecondarySidebar"
        }
      ]
    },
    "commands": [
      {
        "command": "aico.focus",
        "title": "Focus the Panel",
        "category": "aico"
      },
      {
        "command": "aico.open",
        "title": "Open the Full Workspace",
        "category": "aico"
      },
      {
        "command": "aico.openSettings",
        "title": "Settings (providers, models, MCP)",
        "category": "aico"
      },
      {
        "command": "aico.askAboutSelection",
        "title": "Ask aico about this selection",
        "category": "aico"
      },
      {
        "command": "aico.newSession",
        "title": "New Session",
        "category": "aico"
      },
      {
        "command": "aico.stopServer",
        "title": "Stop the Server",
        "category": "aico"
      },
      {
        "command": "aico.openInBrowser",
        "title": "Open Workspace in Browser",
        "category": "aico"
      },
      {
        "command": "aico.showOutput",
        "title": "Show Server Log",
        "category": "aico"
      },
      {
        "command": "aico.doctor",
        "title": "Check the Setup (Doctor)",
        "category": "aico"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "aico.askAboutSelection",
          "when": "editorHasSelection",
          "group": "navigation@99"
        }
      ]
    },
    "keybindings": [
      {
        "command": "aico.askAboutSelection",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "aico",
      "properties": {
        "aico.command": {
          "type": "string",
          "default": "aico",
          "markdownDescription": "How to launch aico. Use an absolute path if it is not on your `PATH`. To run a checkout rather than an install, point this at `node` and set `#aico.args#` to the built entry point."
        },
        "aico.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments inserted before 'serve'. Mostly for running a local checkout."
        },
        "aico.port": {
          "type": "number",
          "default": 0,
          "markdownDescription": "Port for the aico server. `0` picks a free one, which is the right default \u2014 a fixed port collides with an aico you started in a terminal."
        },
        "aico.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start the server automatically the first time it is needed, rather than asking."
        },
        "aico.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show running background work in the status bar."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:panel && npm run compile",
    "build:panel": "npm --prefix webview run build",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.94.0",
    "typescript": "^5.6.0"
  }
}
