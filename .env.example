# Copy to .env and fill in the providers you actually use.
# .env is gitignored — never commit real keys.
#
# You only need one. AICO picks a provider from the model name first, then
# from whichever keys are present.

# DeepSeek Platform — deepseek-v4-flash, deepseek-v4-pro
DEEPSEEK_API_KEY=

# Anthropic — claude-sonnet-5, claude-opus-5
ANTHROPIC_API_KEY=

# OpenAI — gpt-5.6-*, gpt-4o, o-series
OPENAI_API_KEY=

# OpenRouter — routes any model, e.g. deepseek/deepseek-v4-flash
OPENROUTER_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Z.AI (GLM)
ZAI_API_KEY=

# Ollama needs no key. Set "provider": "ollama" in ~/.aico/settings.json
# and point baseUrl at your instance if it is not on localhost:11434.
