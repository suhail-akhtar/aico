# Dependencies
node_modules/

# Build output
dist/
dist-test/
*.tsbuildinfo

# Environment / secrets — never commit real keys; see .env.example
.env
.env.*
!.env.example

# aico runtime state, written while the tool runs
.aico/
.studio/
.zcode/

# Editor / assistant local config
.vscode/
.idea/
.claude/
.playwright-mcp/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test output
coverage/
test-output.txt
test-results.txt

# Scratch scaffolding produced by demo runs
tmp/
temp/
expense-tracker/
gym-management/
blog-*/

# Built web client — produced by `npm run build:web`, served by `aico serve`
web-dist/

# Throwaway probe directories from UI testing
ui-probe/
tmp-wire-*/

# An early standalone landing page, superseded by docs/ and referenced by
# nothing. Left on disk rather than deleted; ignored so it stops showing up as
# untracked on every status.
public/

# Emitted beside the source, not written there.
#
# `shared/` is TypeScript imported by three builds, and the extension host's
# `tsc -p ./` has no rootDir — so the moment one of its files imports up into
# shared/, TypeScript computes a common root above the extension and drops the
# compiled .js next to the .ts. It was committed once before this line existed.
shared/**/*.js
shared/**/*.js.map
