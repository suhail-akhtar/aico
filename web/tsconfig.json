{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@aico/ui": ["../shared/ui/index.ts"],
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*", "../shared/ui/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "../web-dist"]
}
