# Copy to .env.local (make setup does this and fills the change-me values with random secrets).
# Never commit .env or .env.local. In production set these as real environment variables or
# mounted secrets; the app also reads KEY=value lines from ./.env and ./.env.local if present.

# Port the app listens on.
PORT=8080

# PostgreSQL. DATABASE_PASSWORD is shared by the app and by the compose database.
DATABASE_URL=jdbc:postgresql://localhost:5432/app
DATABASE_USER=app
DATABASE_PASSWORD=change-me-database-password

# Who authenticates callers. "local" (default): this service registers users, logs them in and
# signs tokens with APP_JWT_SECRET. "oidc": it only verifies access tokens from an external
# provider (see README, "Run behind an OIDC gateway") and needs the three OIDC_* values below.
# APP_AUTH_MODE=local

# Key that signs and verifies access tokens (HS256), local mode only. At least 32 characters; the
# app refuses to start with a short key or with this placeholder. Rotating it signs every user out.
APP_JWT_SECRET=change-me-jwt-signing-key

# oidc mode (placeholders; use your provider's real URLs). The issuer is the exact `iss` of the
# tokens, the JWKS URI is where the signing keys are fetched (often an internal address), the
# audience must be in the token's `aud`.
# APP_AUTH_MODE=oidc
# OIDC_ISSUER=https://idp.example.com/realms/app
# OIDC_JWKS_URI=http://keycloak:8080/realms/app/protocol/openid-connect/certs
# OIDC_AUDIENCE=app-api
# OIDC_CLOCK_SKEW=30s
# OIDC_JWKS_MIN_REFRESH=30s
# Behind a proxy or gateway, so rate limits are per user instead of per proxy:
# SERVER_FORWARD_HEADERS_STRATEGY=native

# Browser origins allowed to call the API, comma separated. Empty = no cross-origin access.
APP_CORS_ALLOWED_ORIGINS=

# Serve /v3/api-docs and /swagger-ui. Off by default in the production image.
APP_DOCS_ENABLED=true

# Optional tuning (defaults shown).
# APP_JWT_TTL=15m
# APP_BCRYPT_COST=12
# APP_MAX_BODY_SIZE=256KB
# APP_RATE_LIMIT_CAPACITY=120
# APP_RATE_LIMIT_PER_MINUTE=120
# APP_RATE_LIMIT_AUTH_CAPACITY=10
# APP_RATE_LIMIT_AUTH_PER_MINUTE=10

# OpenTelemetry export, off unless enabled.
# APP_OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
