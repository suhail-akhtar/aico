{
  "name": "web-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React single-page app: typed API client, BFF cookie session, items worked feature.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "fmt": "biome check --write .",
    "fmt:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cov": "vitest run --coverage",
    "gen": "openapi-ts",
    "gen:check": "node --disable-warning=ExperimentalWarning scripts/check-generated.ts",
    "audit": "node --disable-warning=ExperimentalWarning scripts/audit.ts",
    "sbom": "npm sbom --sbom-format cyclonedx --sbom-type application > sbom.cdx.json",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "check": "npm run fmt:check && npm run lint && npm run typecheck && npm run gen:check && npm run cov && npm run audit && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.42",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "axe-core": "4.14.0",
    "jsdom": "30.1.2",
    "msw": "3.0.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "msw": "$msw",
    "js-yaml": "4.3.2"
  }
}
