# Container configuration (the nginx image reads these at start and writes /config.json).
# Every URL must be a path on the same origin; the entrypoint refuses anything else.
# Nothing here is a secret: everything in config.json is delivered to the browser.
WEB_PORT=8080
API_BASE_URL=/api
LOGIN_URL=/api/auth/start
LOGOUT_URL=/api/auth/sign_out?rd=/
APP_ENVIRONMENT=production

# Development only: proxy /api to a real gateway instead of using the built-in mock.
# DEV_API_ORIGIN=http://localhost:8080
