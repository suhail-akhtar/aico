# One line ending everywhere: LF. A CRLF checkout turns `sh\r: not found` into the
# error message of a container that worked yesterday.
* text=auto eol=lf
*.sh text eol=lf
Makefile text eol=lf
*.png binary
*.ico binary
*.woff2 binary
package-lock.json text eol=lf -diff
# Generated: collapsed in reviews, regenerated by `npm run gen` and `npm run build`.
src/api/generated/** linguist-generated=true -diff
src/routeTree.gen.ts linguist-generated=true -diff
