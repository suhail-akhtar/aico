# Copy to .env for local development. Never commit .env.
# Any OpenAI-compatible endpoint: OpenAI, OpenRouter, DeepSeek, Kimi, a local Ollama (http://localhost:11434/v1).
MODEL_BASE_URL=https://api.openai.com/v1
# Leave empty for a local endpoint that needs none.
MODEL_API_KEY=
MODEL=gpt-4o-mini
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/app.sqlite
