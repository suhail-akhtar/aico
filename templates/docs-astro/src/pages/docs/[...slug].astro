---
import { getCollection, render } from 'astro:content';
import Docs from '@/layouts/Docs.astro';

export async function getStaticPaths() {
  const entries = await getCollection('docs', e => !e.data.draft);
  return entries.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<Docs title={entry.data.title} description={entry.data.description} id={entry.id}>
  <h1>{entry.data.title}</h1>
  {entry.data.description && <p class="lede">{entry.data.description}</p>}
  {headings.filter(h => h.depth === 2).length > 2 && (
    <nav class="toc" aria-label="On this page">
      <ul>{headings.filter(h => h.depth === 2).map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
    </nav>
  )}
  <Content />
</Docs>
