# Copy to .env for local use. Never commit .env. Every value starting `change-me`
# is replaced by a random one when AICO creates an app from this template; replace
# them by hand otherwise (openssl rand -hex 32).

APP_ENV=development

# Who vouches for the caller: `local` (this service's own accounts and tokens, the
# default) or `oidc` (behind an identity provider such as Keycloak: see the section
# at the end, and "Run behind an OIDC gateway" in README.md).
AUTH_MODE=local
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# Development database: a local SQLite file, created and migrated on start.
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
AUTO_MIGRATE=true
LOG_FORMAT=console

# `python -m app.cli seed` creates demo@example.com with this password (dev only).
SEED_PASSWORD=change-me-dev-password

# Browser origins allowed to call the API (comma separated, no wildcard).
ALLOWED_ORIGINS=http://localhost:3000

# Read by compose.yaml only (docker compose up).
POSTGRES_PASSWORD=change-me-postgres

# Optional tuning, with the defaults:
# SERVICE_NAME=api-service
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# JWT_ISSUER=api-service
# JWT_AUDIENCE=api-service-clients
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=14
# REGISTRATION_ENABLED=true
# ARGON2_TIME_COST=3
# ARGON2_MEMORY_COST_KIB=65536
# ARGON2_PARALLELISM=2
# MAX_BODY_BYTES=1048576
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_DEFAULT=120/minute
# RATE_LIMIT_AUTH=10/minute
# DOCS_ENABLED=true
# LOG_LEVEL=INFO

# AUTH_MODE=oidc: all three are then required (the service refuses to start without them)
# and JWT_SECRET is not needed. Values below are placeholders for a Keycloak realm `app`.
# OIDC_ISSUER=http://localhost:8080/idp/realms/app
# OIDC_JWKS_URI=http://keycloak:8080/idp/realms/app/protocol/openid-connect/certs
# OIDC_AUDIENCE=app-api
# Optional OIDC tuning, with the defaults:
# OIDC_CLOCK_SKEW_SECONDS=30
# OIDC_JWKS_CACHE_SECONDS=600
# OIDC_JWKS_MIN_REFETCH_SECONDS=30
# OIDC_JWKS_TIMEOUT_SECONDS=5

# Set by the platform in front of the container, not read by the app:
# FORWARDED_ALLOW_IPS=10.0.0.5     trust X-Forwarded-* from this proxy only
# WEB_CONCURRENCY=2                uvicorn workers in one container

# OpenTelemetry stays off until a collector is set (traces, metrics, logs over OTLP):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=api-service
