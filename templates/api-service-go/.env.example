# Copy to .env (`make setup` does, and generates the secrets). Never commit .env.
# Read by docker compose for the services in compose.yaml, and by the Makefile.

# Host port the API is published on.
PORT=8080
APP_ENV=development

# Generated secrets. Use only URL-safe characters: the password is spliced into
# DATABASE_URL (percent-encode it if you choose your own).
POSTGRES_PASSWORD=change-me-db-password
SEED_PASSWORD=change-me-seed-password

# Optional.
# DB_PORT=5432          # host port for PostgreSQL if 5432 is taken
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://app.example.com
# LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Run behind an OIDC gateway (see README, "Run behind an OIDC gateway"). Default: local.
# AUTH_MODE=oidc
# OIDC_ISSUER=http://localhost:8080/idp/realms/app            # exact `iss` of the tokens
# OIDC_JWKS_URI=http://keycloak:8080/idp/realms/app/protocol/openid-connect/certs
# OIDC_AUDIENCE=app-api                                       # required `aud`
# OIDC_CLOCK_SKEW=30s                                         # exp/nbf leeway, at most 60s
