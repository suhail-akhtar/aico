{
  "name": "system-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single-page app for system-medium: BFF cookie session, tasks, attachments, admin views.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fmt": "biome check --write .",
    "fmt:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run",
    "cov": "vitest run --coverage",
    "audit": "npm audit --audit-level=high --omit=dev",
    "check": "npm run fmt:check && npm run lint && npm run typecheck && npm run cov && npm run audit && npm run build"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
