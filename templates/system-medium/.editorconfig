root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
# google-java-format (Spotless) is the source of truth; this keeps editors in step with it.
indent_size = 2
continuation_indent_size = 4
max_line_length = 100

[*.{cmd,bat}]
end_of_line = crlf

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
