# Copy to .env (`make setup` does it and fills every change-me with a random value). Never commit .env.
# Compose refuses to start while a required value is missing.

# Host ports (everything is published on 127.0.0.1 only)
APP_PORT=8080
IDP_PORT=8180
MAILPIT_PORT=8025

# Databases and cache
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
VALKEY_PASSWORD=change-me

# Object storage (SeaweedFS S3 identity)
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# Identity provider
KEYCLOAK_ADMIN_PASSWORD=change-me
OIDC_CLIENT_SECRET=change-me
AUTOMATION_CLIENT_SECRET=change-me
# Password of the dev users alice (member) and bob (admin) imported with the realm. Dev only.
DEV_USER_PASSWORD=change-me
