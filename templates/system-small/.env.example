# Copied to .env (gitignored) when the app is created; every change-me value becomes a random secret.
# Never commit .env. Production: inject these from your secret manager, not a file.
DB_PASSWORD=change-me-db
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
OIDC_CLIENT_SECRET=change-me-client-secret
COOKIE_SECRET=change-me-cookie-secret
DEV_USER_PASSWORD=change-me-dev-user
# Optional
# AICO_PREVIEW_PORT=8080
# COOKIE_SECURE=true   (set behind HTTPS)
