# Copy to .env (`make setup` does it and generates APP_KEY). .env is git-ignored.
# Docker Compose reads this file for ${VARIABLES}; the app reads real environment
# variables first, so the same names work on any host (Fly, Render, Kubernetes...).

APP_NAME="__APP_TITLE__"
APP_ENV=local
# Generated by `make setup` (or: docker compose run --rm tools php artisan key:generate --show).
# Never commit it; rotating it signs everyone out and invalidates encrypted data.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080
MAILPIT_PORT=8025
# `make dev` only: the Vite dev server (hot reload).
VITE_PORT=5173

# Comma-separated proxy IPs/CIDRs whose X-Forwarded-* headers are believed (empty = none).
TRUSTED_PROXIES=

# One JSON object per line on stderr: what `docker logs` and log collectors read.
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# PostgreSQL (the compose `db` service). Tests use SQLite in memory and need none of this.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=change-me-db-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Secure cookies are the default in production; compose over plain http turns them off.
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database

# Mail goes to Mailpit in development: http://localhost:8025
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Passwords: Argon2id, OWASP minimum is 19456 KiB / 2 / 1. The app refuses to start below it.
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=3
ARGON_THREADS=1

# API tokens expire after this many minutes (30 days).
API_ACCESS_TTL_MINUTES=43200
# Exact browser origins allowed to call the API cross-origin (empty = none). Never "*".
CORS_ALLOWED_ORIGINS=
# Serve the OpenAPI document at /docs/api.json outside local development.
API_DOCS_ENABLED=false
