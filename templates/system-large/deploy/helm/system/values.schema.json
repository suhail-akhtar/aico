{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "system chart values",
  "description": "Helm validates this on lint, template, install and upgrade. additionalProperties is false everywhere a key set is known, so a misspelt key is an error, not a silent no-op.",
  "type": "object",
  "additionalProperties": false,
  "required": ["global", "ingress", "monitoring", "networkPolicy", "serviceDefaults", "services"],
  "$defs": {
    "dns1123": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"},
    "quantity": {"anyOf": [{"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|T|P|E|Ki|Mi|Gi|Ti|Pi|Ei)?$"}, {"type": "number"}]},
    "stringMap": {"type": "object", "additionalProperties": {"type": "string"}},
    "labelSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchLabels": {"$ref": "#/$defs/stringMap"},
        "matchExpressions": {"type": "array", "items": {"type": "object"}}
      }
    },
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "podSelector": {"$ref": "#/$defs/labelSelector"},
        "namespaceSelector": {"$ref": "#/$defs/labelSelector"},
        "ipBlock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cidr"],
          "properties": {"cidr": {"type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"}, "except": {"type": "array", "items": {"type": "string"}}}
        }
      }
    },
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "egressRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to", "ports"],
      "properties": {
        "to": {"type": "string", "minLength": 1},
        "ports": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/port"}},
        "protocol": {"enum": ["TCP", "UDP"]}
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "periodSeconds": {"type": "integer", "minimum": 1},
        "failureThreshold": {"type": "integer", "minimum": 1}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9./_-]*$"},
        "tag": {"type": "string", "pattern": "^$|^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$", "not": {"const": "latest"}},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"}
      },
      "anyOf": [
        {"properties": {"tag": {"minLength": 1}}, "required": ["tag"]},
        {"properties": {"digest": {"minLength": 1}}, "required": ["digest"]}
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object", "additionalProperties": false, "required": ["cpu", "memory"],
          "properties": {"cpu": {"$ref": "#/$defs/quantity"}, "memory": {"$ref": "#/$defs/quantity"}, "ephemeral-storage": {"$ref": "#/$defs/quantity"}}
        },
        "limits": {
          "type": "object", "additionalProperties": false, "required": ["cpu", "memory"],
          "properties": {"cpu": {"$ref": "#/$defs/quantity"}, "memory": {"$ref": "#/$defs/quantity"}, "ephemeral-storage": {"$ref": "#/$defs/quantity"}}
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "springEnv", "replicas", "resources", "autoscaling", "pdb", "service", "ingress", "secrets", "metrics", "networkPolicy"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/$defs/image"},
        "springEnv": {"type": "boolean"},
        "env": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}, "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}},
        "replicas": {"type": "integer", "minimum": 1, "maximum": 100},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1, "maximum": 600},
        "preStopSleepSeconds": {"type": "integer", "minimum": 1, "maximum": 120},
        "resources": {"$ref": "#/$defs/resources"},
        "autoscaling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"},
            "minReplicas": {"type": "integer", "minimum": 1},
            "maxReplicas": {"type": "integer", "minimum": 1},
            "targetCPUUtilizationPercentage": {"type": "integer", "minimum": 1, "maximum": 100},
            "targetMemoryUtilizationPercentage": {"type": "integer", "minimum": 1, "maximum": 100}
          }
        },
        "pdb": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"},
            "minAvailable": {"type": ["integer", "string"]},
            "maxUnavailable": {"type": ["integer", "string"]}
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "port"],
          "properties": {"type": {"enum": ["ClusterIP"]}, "port": {"$ref": "#/$defs/port"}}
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "paths"],
          "properties": {
            "enabled": {"type": "boolean"},
            "paths": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false, "required": ["path"],
                "properties": {"path": {"type": "string", "pattern": "^/"}, "pathType": {"enum": ["Prefix", "Exact", "ImplementationSpecific"]}}
              }
            }
          }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "keys"],
          "properties": {
            "enabled": {"type": "boolean"},
            "remoteName": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
            "keys": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}}
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "path"],
          "properties": {"enabled": {"type": "boolean"}, "path": {"type": "string", "pattern": "^/"}}
        },
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"startup": {"$ref": "#/$defs/probe"}, "readiness": {"$ref": "#/$defs/probe"}, "liveness": {"$ref": "#/$defs/probe"}}
        },
        "extraVolumes": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "mountPath"],
            "properties": {"name": {"$ref": "#/$defs/dns1123"}, "mountPath": {"type": "string", "pattern": "^/"}, "sizeLimit": {"$ref": "#/$defs/quantity"}}
          }
        },
        "serviceAccountAnnotations": {"$ref": "#/$defs/stringMap"},
        "nodeSelector": {"$ref": "#/$defs/stringMap"},
        "tolerations": {"type": "array", "items": {"type": "object"}},
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dns", "ingressFrom"],
          "properties": {
            "dns": {"type": "boolean"},
            "ingressFrom": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "egress": {"type": "array", "items": {"$ref": "#/$defs/egressRule"}},
            "extraEgress": {"type": "array", "items": {"$ref": "#/$defs/egressRule"}}
          }
        }
      }
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "domain", "imagePullPolicy", "externalSecrets", "env"],
      "properties": {
        "environment": {"enum": ["dev", "staging", "prod"]},
        "domain": {"type": "string", "pattern": "^([a-z0-9-]+\\.)+[a-z]{2,}$"},
        "imagePullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
        "imagePullSecrets": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string"}}}},
        "requireImageDigest": {"type": "boolean"},
        "commonLabels": {"$ref": "#/$defs/stringMap"},
        "commonAnnotations": {"$ref": "#/$defs/stringMap"},
        "topologySpread": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "zone": {"enum": ["DoNotSchedule", "ScheduleAnyway"]},
            "node": {"enum": ["DoNotSchedule", "ScheduleAnyway"]}
          }
        },
        "externalSecrets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "refreshInterval", "secretStoreRef", "remoteKeyPrefix"],
          "properties": {
            "enabled": {"type": "boolean"},
            "refreshInterval": {"type": "string", "pattern": "^[0-9]+(s|m|h)$"},
            "secretStoreRef": {
              "type": "object", "additionalProperties": false, "required": ["kind", "name"],
              "properties": {"kind": {"enum": ["ClusterSecretStore", "SecretStore"]}, "name": {"$ref": "#/$defs/dns1123"}}
            },
            "remoteKeyPrefix": {"type": "string", "pattern": "^[A-Za-z0-9/_.-]+$"}
          }
        },
        "env": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}, "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}}
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "controller", "className", "tls"],
      "properties": {
        "enabled": {"type": "boolean"},
        "controller": {"enum": ["traefik", "generic"]},
        "className": {"type": "string", "minLength": 1},
        "hosts": {
          "type": "object", "additionalProperties": false,
          "properties": {"app": {"type": "string"}, "idp": {"type": "string"}}
        },
        "tls": {
          "type": "object", "additionalProperties": false, "required": ["secretName"],
          "properties": {"secretName": {"$ref": "#/$defs/dns1123"}}
        },
        "annotations": {"$ref": "#/$defs/stringMap"},
        "rateLimit": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "average": {"type": "integer", "minimum": 1},
            "burst": {"type": "integer", "minimum": 1},
            "proxyDepth": {"type": "integer", "minimum": 0}
          }
        },
        "idp": {
          "type": "object", "additionalProperties": false,
          "properties": {"enabled": {"type": "boolean"}, "service": {"$ref": "#/$defs/dns1123"}, "port": {"$ref": "#/$defs/port"}}
        }
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceMonitor": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "interval": {"type": "string", "pattern": "^[0-9]+(s|m)$"},
            "scrapeTimeout": {"type": "string", "pattern": "^[0-9]+(s|m)$"},
            "labels": {"$ref": "#/$defs/stringMap"}
          }
        },
        "prometheusRule": {
          "type": "object", "additionalProperties": false,
          "properties": {"enabled": {"type": "boolean"}, "labels": {"$ref": "#/$defs/stringMap"}, "runbookBaseUrl": {"type": "string", "pattern": "^https?://"}}
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "peers"],
      "properties": {
        "enabled": {"type": "boolean"},
        "defaultDeny": {"type": "boolean"},
        "peers": {
          "type": "object",
          "required": ["kube-dns"],
          "additionalProperties": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/peer"}}
        }
      }
    },
    "serviceDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1},
        "preStopSleepSeconds": {"type": "integer", "minimum": 1},
        "probes": {
          "type": "object", "additionalProperties": false,
          "properties": {"startup": {"$ref": "#/$defs/probe"}, "readiness": {"$ref": "#/$defs/probe"}, "liveness": {"$ref": "#/$defs/probe"}}
        }
      }
    },
    "services": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/dns1123"},
      "additionalProperties": {"$ref": "#/$defs/service"}
    }
  }
}
