{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Error"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Postgres",
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "api-service",
    "Audience": "api-service",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "RateLimit": {
    "PermitLimit": 120,
    "AuthPermitLimit": 10,
    "WindowSeconds": 60
  },
  "Limits": {
    "MaxRequestBodyBytes": 1048576
  },
  "OpenApi": {
    "Enabled": true
  }
}
