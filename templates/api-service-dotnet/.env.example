# Copy to .env for local use (AICO writes the same file as .env.local, with real random values).
# Never commit .env. Configuration is environment-only; the app validates it at startup and refuses
# to start on a missing or unsafe value, naming the key.
#
# Development needs only the two secrets below: it runs on SQLite with no database server.
# Variable names are ASP.NET Core configuration paths with "__" for ":" (Jwt__SigningKey = Jwt:SigningKey).

# Signs access tokens. At least 32 characters; generate with: openssl rand -base64 48
Jwt__SigningKey=change-me-jwt-signing-key

# Password of the demo user created in Development (email demo@example.test). Leave empty for no seed.
Seed__DemoPassword=change-me-demo-password

# Password of the PostgreSQL user in compose.yaml (`make up`). Not used by `make dev`.
POSTGRES_PASSWORD=change-me-postgres-password

# --- Behind an OIDC gateway (see README, "Run behind an OIDC gateway") ----------------------------
# Default is AUTH_MODE=local (this service signs its own tokens, Jwt__SigningKey above). With oidc the service only
# validates tokens from your identity provider; the three OIDC_* values are then required and Jwt__SigningKey is unused.
# AUTH_MODE=oidc
# OIDC_ISSUER=https://idp.example.com/realms/app
# OIDC_JWKS_URI=http://keycloak:8080/realms/app/protocol/openid-connect/certs
# OIDC_AUDIENCE=app-api

# --- Optional -----------------------------------------------------------------------------------
# Browser origins allowed to call the API (comma-separated exact origins). Empty = none.
# Cors__AllowedOrigins=https://app.example.com
# Requests per client per window (and the stricter budget for /auth).
# RateLimit__PermitLimit=120
# RateLimit__AuthPermitLimit=10
# Behind a reverse proxy: trust X-Forwarded-* from these CIDR ranges only.
# ForwardedHeaders__Enabled=true
# ForwardedHeaders__KnownNetworks=10.0.0.0/8
# Traces, metrics and logs go to this OTLP endpoint; unset = telemetry off.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Production against your own PostgreSQL (never SQLite):
# ConnectionStrings__Default=Host=db;Database=app;Username=app;Password=<secret>
# Database__MigrateOnStartup=false   # run `ApiService --migrate` as a one-shot job instead
