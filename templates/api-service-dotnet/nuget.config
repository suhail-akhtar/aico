<?xml version="1.0" encoding="utf-8"?>
<!-- One source, mapped explicitly: a package can only come from nuget.org, so a
     private feed on a developer machine can never shadow a public name
     (dependency confusion). Add a feed here AND a mapping, or neither. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
