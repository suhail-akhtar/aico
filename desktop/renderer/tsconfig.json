{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@aico/ui": ["../../shared/ui/index.ts"],
      "@aico/reasoning": ["../../shared/reasoning.ts"],
      "@aico/shared/*": ["../../shared/*"],
      "@web/*": ["../../web/src/*"],
      "@desk/*": ["../shared/*"],
      "@/*": ["src/*"],
      "zustand": ["../../web/node_modules/zustand"]
    }
  },
  "include": ["src/**/*", "../shared/**/*", "../../shared/ui/**/*", "../../web/src/**/*"],
  "exclude": ["node_modules"]
}
